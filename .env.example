# Environment variables for SoloSwim

# Public site URL (no trailing slash), e.g. https://www.soloswim.be
HOST=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MongoDB connection string
MONGODB_URL=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_CONTACT_API_KEY=

# Google Analytics measurement ID
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Optional: protects POST /api/orders and /api/order-confirmation-email
# (webhook fulfillment does not need this — it calls lib functions directly)
INTERNAL_API_SECRET=
