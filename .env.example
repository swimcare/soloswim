# Public site URL (no trailing slash)
HOST=https://www.soloswim.be

# Google Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Stripe (use test keys locally; live keys only on the server .env)
STRIPE_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_CONTACT_API_KEY=

# MongoDB
# Local Docker Compose overrides this to: mongodb://mongo:27017/soloswim
# Keep Atlas only if you intentionally use it.
MONGODB_URL=mongodb://mongo:27017/soloswim

# Optional: protect internal order/email HTTP endpoints
INTERNAL_API_SECRET=
