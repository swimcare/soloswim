# Public site URL (no trailing slash) — used at runtime for Stripe success/cancel URLs
HOST=https://www.soloswim.be

# Google Analytics measurement ID (G-XXXXXXXX)
# Prefer GOOGLE_ANALYTICS_ID (runtime, not inlined by Next.js).
# NEXT_PUBLIC_GOOGLE_ANALYTICS still works as fallback via /api/public-config.
GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Stripe — required at runtime on the server (.env). Never put these in the Dockerfile.
# STRIPE_WEBHOOK_SECRET must match the signing secret of the endpoint
# https://www.soloswim.be/api/webhook in Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=sk_live_..._or_sk_test_...
# Optional: only needed if something still reads the publishable key client-side
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mailgun — required at runtime for order confirmation + contact form
MAILGUN_API_KEY=
# Sending domain verified in Mailgun
MAILGUN_DOMAIN=mg.swimcare.be
# EU: https://api.eu.mailgun.net  |  US: https://api.mailgun.net
MAILGUN_API_URL=https://api.eu.mailgun.net
# Use quotes when the value contains spaces or < >
MAILGUN_FROM="SoloSwim <postmaster@mg.swimcare.be>"
# Replies from customers go here (From stays on mg.* for SPF/DKIM)
MAILGUN_REPLY_TO=info@soloswim.be
# Exact template name as shown in Mailgun (Sending → Templates)
MAILGUN_ORDER_TEMPLATE="soloswim bedankt voor je bestelling"
MAILGUN_ORDER_BCC=kristof@soloswim.be
# Contact-form notification recipients (comma-separated)
MAILGUN_CONTACT_TO=info@soloswim.be,kristof@soloswim.be

# Mailchimp — SwimCare audience + SoloSwim tag (newsletter footer form)
# API key from Mailchimp → Account → Extras → API keys (often ends with -usXX or -us21)
MAILCHIMP_API_KEY=
# Audience / list ID (Audience → Settings → Audience name and defaults)
MAILCHIMP_AUDIENCE_ID=
# Optional: server prefix (us21, us6, …). Defaults to the suffix of MAILCHIMP_API_KEY
MAILCHIMP_SERVER_PREFIX=
# Tag applied to every SoloSwim signup (default SoloSwim)
MAILCHIMP_TAG=SoloSwim
# pending = double opt-in confirmation mail (recommended EU); subscribed = direct
MAILCHIMP_STATUS_IF_NEW=pending

# Trustpilot — score widget (TrustBox) + review CTAs
# Business Unit ID: Trustpilot Business → Integrations → TrustBox → copy Business Unit ID
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
# Optional override of the public profile URL
NEXT_PUBLIC_TRUSTPILOT_URL=https://nl-be.trustpilot.com/review/soloswim.be

# MongoDB
# docker-compose.yml overrides this to mongodb://mongo:27017/soloswim
MONGODB_URL=mongodb://mongo:27017/soloswim

# Optional: protect internal order/email HTTP endpoints
INTERNAL_API_SECRET=
