# Public site URL (no trailing slash) — used at runtime for Stripe success/cancel URLs
HOST=https://www.soloswim.be

# Google Analytics (optional build-arg when building the Docker image)
NEXT_PUBLIC_GOOGLE_ANALYTICS=

# Stripe — required at runtime on the server (.env). Never put these in the Dockerfile.
# STRIPE_WEBHOOK_SECRET must match the signing secret of the endpoint
# https://www.soloswim.be/api/webhook in Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SECRET_KEY=sk_live_..._or_sk_test_...
# Optional: only needed if something still reads the publishable key client-side
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mailgun — required at runtime for order confirmation + contact form
MAILGUN_API_KEY=
# Sending domain verified in Mailgun
MAILGUN_DOMAIN=mg.swimcare.be
# EU: https://api.eu.mailgun.net  |  US: https://api.mailgun.net
MAILGUN_API_URL=https://api.eu.mailgun.net
MAILGUN_FROM=SoloSwim <postmaster@mg.swimcare.be>
# Exact template name as shown in Mailgun (Sending → Templates)
MAILGUN_ORDER_TEMPLATE=soloswim bedankt voor je bestelling
MAILGUN_ORDER_BCC=kristof@soloswim.be
MAILGUN_CONTACT_TO=kristof@soloswim.be

# MongoDB
# docker-compose.yml overrides this to mongodb://mongo:27017/soloswim
MONGODB_URL=mongodb://mongo:27017/soloswim

# Optional: protect internal order/email HTTP endpoints
INTERNAL_API_SECRET=
